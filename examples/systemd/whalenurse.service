# whalenurse under systemd, hardened. Install:
#   sudo useradd --system --home-dir /var/lib/whalenurse --shell /usr/sbin/nologin --groups docker whalenurse
#   sudo install -m 0755 whalenurse /usr/local/bin/whalenurse
#   sudo install -m 0644 whalenurse.service /etc/systemd/system/whalenurse.service
#   sudo install -d -m 0750 -o root -g whalenurse /etc/whalenurse
#   sudo install -m 0640 -o root -g whalenurse whalenurse.env /etc/whalenurse/whalenurse.env   # settings and secrets (see whalenurse.env.example)
#   sudo systemctl daemon-reload && sudo systemctl enable --now whalenurse
#
# The user is in the docker group, which is root-equivalent on this host (docs/security.md): the hardening below limits what
# a bug in whalenurse can do besides what the Docker socket already allows. Your stacks must be readable by that user (for the
# recreate rung); they are mounted read-only into the service by ProtectSystem/ProtectHome below.
# To use the CLI (the control socket is mode 0600, and this unit moves it):
#   sudo -u whalenurse env WHALENURSE_CONTROL_SOCKET=/run/whalenurse/whalenurse.sock whalenurse status
[Unit]
Description=whalenurse, compose-aware self-healing for Docker hosts
Documentation=https://github.com/jackspiering/whalenurse/tree/main/docs
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=whalenurse
Group=whalenurse
SupplementaryGroups=docker
ExecStart=/usr/local/bin/whalenurse run
Restart=on-failure
RestartSec=5s
# A stop lets an action in flight (a compose recreate) finish for up to 30 s, then stops compose with SIGTERM and kills
# it 10 s later; it also writes the heartbeat. mixed sends the SIGTERM to whalenurse only, so systemd does not stop the
# compose child halfway itself (it still SIGKILLs what is left at the timeout).
KillMode=mixed
TimeoutStopSec=60s

# State and the control socket, created and owned by systemd.
StateDirectory=whalenurse
StateDirectoryMode=0700
RuntimeDirectory=whalenurse
RuntimeDirectoryMode=0700
Environment=WHALENURSE_DATA_DIR=/var/lib/whalenurse
Environment=WHALENURSE_CONTROL_SOCKET=/run/whalenurse/whalenurse.sock
# Everything else (WHALENURSE_NOTIFY_URLS, WHALENURSE_HTTP_ADDR, WHALENURSE_HTTP_TOKEN ...): see docs/configuration.md.
# The file holds secrets; the leading "-" lets the unit start without it.
EnvironmentFile=-/etc/whalenurse/whalenurse.env

# Hardening
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# A syscall outside the filter fails with EPERM instead of killing the process; if the journal ever shows one, say so in an issue.
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
