# Copy to .env (git ignores it) and fill in. These values are secrets: keep the file mode 0600.

# stat -c %g /var/run/docker.sock
DOCKER_GID=999
# The directory that holds your stacks, mounted read-only at this identical path.
STACKS_DIR=/opt/stacks
# The host's compose plugin (docker info shows the path).
COMPOSE_PLUGIN=/usr/libexec/docker/cli-plugins/docker-compose

# This Docker host's name in container keys and notifications (without it, the name is whalenurse's container ID).
WHALENURSE_HOST_ID=my-docker-host

# openssl rand -hex 24. Required: the dashboard is reachable from your tailnet.
WHALENURSE_HTTP_TOKEN=replace-with-a-long-random-token
# The "dashboard" network between whalenurse and tailscale (trusted as the proxy); change it if Docker says the pool overlaps.
# DASHBOARD_SUBNET=10.84.248.0/29
# A Tailscale auth key (https://login.tailscale.com/admin/settings/keys), reusable or not.
TS_AUTHKEY=tskey-auth-replace-me

# Shoutrrr URLs, separated by spaces: https://nicholas-fedor.github.io/shoutrrr/
WHALENURSE_NOTIFY_URLS=ntfy://ntfy.example.com/replace-with-a-private-topic
# An uptime-monitor push URL (healthchecks.io, Uptime Kuma); optional.
WHALENURSE_HEARTBEAT_URL=

# Start in dry-run (decisions are logged and notified, nothing is changed). Set to false when they look right.
WHALENURSE_DRY_RUN=true
